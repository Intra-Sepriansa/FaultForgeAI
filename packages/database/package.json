{
  "name": "@faultforge/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --loader ts-node/esm src/seed.ts",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "npx tsx src/seed.ts"
  },
  "dependencies": {
    "@faultforge/config": "*",
    "@prisma/client": "^6.4.1",
    "ioredis": "^5.5.0",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
