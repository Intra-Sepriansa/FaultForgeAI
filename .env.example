# ==============================================================================
# FaultForge AI — Environment Configuration Template
# Copy this file to .env before starting the development environment.
# NEVER commit raw secret values to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://faultforge:faultforge_secure_pass@localhost:5432/faultforge_db?schema=public

# Redis & Queue Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=faultforge_redis_pass
REDIS_URL=redis://:faultforge_redis_pass@localhost:6379/0

# Session & Security
SESSION_SECRET=c2VjdXJlX3JhbmRvbV8zMl9ieXRlc19zZXNzaW9uX3NlY3JldF9mYXVsdGZvcmdl
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OIDC Identity Provider (Local Mock or External)
OIDC_ISSUER_URL=http://localhost:4000/api/v1/auth/oidc/mock
OIDC_CLIENT_ID=faultforge-web-client
OIDC_CLIENT_SECRET=faultforge_oidc_secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# AI Model Provider Configuration
AI_PROVIDER=mock
OPENAI_API_KEY=mock-openai-key
ANTHROPIC_API_KEY=mock-anthropic-key

# Sandbox Controller
SANDBOX_CONCURRENCY_LIMIT=5
SANDBOX_TIMEOUT_MS=60000
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_MB=256

# Observability & Telemetry
OTEL_SERVICE_NAME=faultforge-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
